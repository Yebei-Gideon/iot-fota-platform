{
  "name": "@fota/api-gateway",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "bun build src/main.ts --minify --target=node --external @nestjs/* --external class-validator --external class-transformer --external kafkajs --external nats --external @grpc/* --external mqtt --outfile ./dist/main.js",
    "dev": "bun --watch src/main.ts",
    "debug": "bun --inspect src/main.ts",
    "start": "bun run ./dist/main.js",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "tsc --noEmit --incremental"
  },
  "dependencies": {
    "@fota/configs": "workspace:*",
    "@fota/database": "workspace:*",
    "@fota/logger": "workspace:*",
    "@fota/types": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
