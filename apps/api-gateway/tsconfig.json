{
  "extends": "@fota/configs/tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolvePackageJsonExports": true,
    "strictBindCallApply": true,
    "noImplicitAny": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "eslint.config.ts"
  ]
}
