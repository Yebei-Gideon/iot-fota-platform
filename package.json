{
  "name": "iot-fota-platform",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @fota/api-gateway dev",
    "dev:web": "bun --filter @fota/web dev",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test --workspaces",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "bun-workspaces": "^1.12.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^15.4.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "apps/api-gateway/src/**/*.ts": [
      "bun --cwd apps/api-gateway lint:fix"
    ],
    "apps/web/**/*.{ts,vue,css}": [
      "bun --cwd apps/web lint:fix"
    ],
    "packages/configs/**/*.ts": [
      "bun --cwd packages/configs lint:fix"
    ],
    "packages/contracts/**/*.ts": [
      "bun --cwd packages/contracts lint:fix"
    ],
    "packages/database/**/*.ts": [
      "bun --cwd packages/database lint:fix"
    ],
    "packages/dtos/**/*.ts": [
      "bun --cwd packages/dtos lint:fix"
    ],
    "packages/types/**/*.ts": [
      "bun --cwd packages/types lint:fix"
    ]
  }
}
