{
  "name": "iot-fota-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @fota/api-gateway dev",
    "dev:web": "bun --filter @fota/web dev",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test --workspaces",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "bun-workspaces": "^1.12.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "apps/api-gateway/src/**/*.ts": [
      "bunx --bun eslint --config packages/configs/eslint.config.ts --fix"
    ],
    "apps/web/**/*.{ts,vue}": [
      "bunx --bun eslint --config packages/configs/eslint.config.ts --fix"
    ],
    "packages/**/*.ts": [
      "bunx --bun eslint --config packages/configs/eslint.config.ts --fix"
    ]
  }
}