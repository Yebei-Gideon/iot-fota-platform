{
  "name": "@fota/database",
  "type": "module",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "DEBUG='prisma:config,prisma:client-generator-ts*' prisma generate",
    "db:migrate": "DEBUG='prisma:migrate,prisma:engine' prisma migrate dev",
    "db:reset": "DEBUG='prisma:migrate,prisma:engine' prisma migrate reset",
    "lint": "bunx --bun eslint . --cache",
    "lint:fix": "bunx --bun eslint . --cache --fix"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fota/configs": "workspace:*",
    "@fota/logger": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "find-config": "^1.0.0",
    "pg": "^8.22.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0"
  }
}
