generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform-wide key/value configuration store.
model PlatformSettings {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt

  @@map("platform_settings")
}

/// This model contains row level security and requires additional setup for migrations.
model AlertEvents {
  id          String    @id @default(uuid())
  alert_id    String
  message     String
  metadata    Json?
  resolved    Boolean   @default(false)
  resolved_at DateTime?
  created_at  DateTime  @default(now())
  alerts      Alerts    @relation(fields: [alert_id], references: [id], onDelete: Cascade)

  @@index([alert_id])
  @@index([created_at])
  @@index([resolved])
  @@map("alert_events")
}

/// This model contains row level security and requires additional setup for migrations.
model Alerts {
  id           String        @id @default(uuid())
  name         String
  description  String?
  severity     AlertSeverity
  condition    Json
  enabled      Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  user_id      String
  alert_events AlertEvents[]
  users        Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([severity])
  @@index([user_id])
  @@map("alerts")
}

/// This model contains row level security and requires additional setup for migrations.
model AuditLogs {
  id          String      @id @default(uuid())
  user_id     String
  action      AuditAction
  resource    String
  resource_id String?
  changes     Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime    @default(now())
  users       Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([created_at])
  @@index([resource])
  @@index([user_id])
  @@map("audit_logs")
}

/// Group classification of devices to support bulk campaign targeted deployments.
model DeviceGroups {
  id            String         @id @default(uuid())
  name          String
  description   String?
  user_id       String
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  users         Users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  devices       Devices[]      @relation("DeviceToGroup")
  ota_campaigns OtaCampaigns[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("device_groups")
}

/// This model contains row level security and requires additional setup for migrations.
model Devices {
  id                      String            @id @default(uuid())
  device_id               String
  name                    String
  hardware_model          String
  manufacturer            String?
  mac_address             String?           @unique
  hardware_serial         String?           @unique
  current_version         String?
  target_version          String?
  /// Current running monotonic firmware security version (anti-rollback counter)
  security_version        Int               @default(1)
  secure_element_present  Boolean           @default(false)
  status                  DeviceStatus      @default(ACTIVE)
  verified                Boolean           @default(false)
  verified_at             DateTime?
  last_seen_at            DateTime?
  metadata                Json?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  user_id                 String
  /// Authentication type for device-specific auth. 'API_KEY' = shared secret; 'CERT' = mTLS certificate.
  auth_type               String            @default("API_KEY")
  /// bcrypt hash of the per-device secret generated by POST /devices/:id/credentials.
  device_secret_hash      String?
  /// X.509 certificate serial number (hex). Set when the device CSR is signed by the platform CA.
  cert_serial             String?           @unique
  /// SHA-256 fingerprint of the device certificate DER bytes (lowercase hex, no colons).
  cert_fingerprint        String?           @unique
  /// How often this device should poll for OTA updates (days). Null = use platform default.
  ota_check_interval_days Int?
  /// Dev/test override: poll interval in raw seconds (takes priority over days when set).
  ota_check_interval_secs Int?
  users                   Users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  groups                  DeviceGroups[]    @relation("DeviceToGroup")
  ota_targets             OtaTargets[]
  telemetry_events        TelemetryEvents[]
  update_states           UpdateStates[]
  device_api_keys         DeviceApiKeys[]

  // each user may register a given device_id only once
  @@unique([user_id, device_id])
  @@index([device_id])
  @@index([status])
  @@index([user_id])
  @@map("devices")
}

/// Represents a software build image for distribution.
model Firmwares {
  id                            String          @id @default(uuid())
  version                       String
  security_version              Int             @default(1) /// Monotonic SVN/anti-rollback count
  hardware_model                String /// Compatible hardware model
  status                        FirmwareStatus  @default(DRAFT)
  description                   String?
  changelog                     String? /// Release notes
  file_path                     String          @default("") /// Storage path for firmware file
  file_name                     String? /// original filename provided during upload
  file_size                     BigInt?
  checksum                      String?
  algorithm                     String          @default("sha256")
  is_stable                     Boolean         @default(false)
  is_encrypted                  Boolean         @default(false)
  encryption_algorithm          String?
  /// Platform detected from binary header: ESP8266, ESP32, GENERIC_ARM, ELF_UNKNOWN, INTEL_HEX, UNKNOWN
  target_device_platform        String?
  /// Parsed ESP firmware header metadata. Null for non-ESP binaries.
  esp_header_metadata           Json?
  /// Signature algorithm the target device can handle: ED25519, ECDSA_P256, RSA_SHA256
  preferred_signature_algorithm String          @default("ED25519")
  created_at                    DateTime        @default(now())
  updated_at                    DateTime        @updatedAt
  user_id                       String
  users                         Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  manifests                     Manifests[]
  ota_campaigns                 OtaCampaigns[]
  signed_url_logs               SignedUrlLogs[]

  // Relations for binary deltas
  deltas_from FirmwareDeltas[] @relation("DeltaFrom")
  deltas_to   FirmwareDeltas[] @relation("DeltaTo")

  // version/hardware model scoped per user
  @@unique([user_id, version, hardware_model])
  @@index([user_id])
  @@index([version])
  @@index([hardware_model])
  @@index([status])
  @@map("firmwares")
}

/// Multi-path binary delta upgrades (mapping older versions to the target firmware file)
model FirmwareDeltas {
  id               String    @id @default(uuid())
  from_firmware_id String
  to_firmware_id   String
  file_path        String
  file_size        BigInt
  checksum         String
  algorithm        String    @default("sha256")
  created_at       DateTime  @default(now())
  from_firmware    Firmwares @relation("DeltaFrom", fields: [from_firmware_id], references: [id], onDelete: Cascade)
  to_firmware      Firmwares @relation("DeltaTo", fields: [to_firmware_id], references: [id], onDelete: Cascade)

  @@unique([from_firmware_id, to_firmware_id])
  @@index([from_firmware_id])
  @@index([to_firmware_id])
  @@map("firmware_deltas")
}

/// Filesystem image (LittleFS / SPIFFS) — uploaded separately from application firmware.
model FilesystemImages {
  id               String           @id @default(uuid())
  version          String
  security_version Int              @default(1)
  hardware_model   String
  fs_type          FileSystemType   @default(LITTLEFS)
  description      String?
  status           FileSystemStatus @default(DRAFT)
  file_path        String           @default("")
  file_name        String?
  file_size        BigInt?
  checksum         String?
  algorithm        String           @default("sha256")
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  changelog        String?
  is_stable        Boolean          @default(false)
  user_id          String
  users            Users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, version, hardware_model, fs_type])
  @@index([user_id])
  @@index([hardware_model])
  @@index([status])
  @@map("filesystem_images")
}

/// Firmware manifest — one per firmware version; consumed by IoT devices during OTA
model Manifests {
  id                   String    @id @default(uuid())
  firmware_id          String
  /// Increment when the manifest format itself changes
  manifest_version     Int       @default(1)
  /// Hex-encoded SHA-256 of the firmware binary (mandatory for device verification)
  sha256_checksum      String
  content_type         String    @default("application/octet-stream")
  /// Detached signature of the SHA-256 hash, encoded as base64
  signature            String?
  signature_algorithm  String    @default("ED25519")
  /// Reference to the public key used for signing
  public_key_id        String?
  /// If set, devices running below this version are not eligible for the update
  min_firmware_version String?
  /// If set, only devices running at or below this version will receive the update
  max_firmware_version String?
  is_active            Boolean   @default(true)
  metadata             Json?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  firmwares            Firmwares @relation(fields: [firmware_id], references: [id], onDelete: Cascade)

  @@index([firmware_id])
  @@index([is_active])
  @@map("manifests")
}

/// This model contains row level security and requires additional setup for migrations.
model OtaCampaigns {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  firmware_id        String
  group_id           String? /// Optional target device group to populate targets from
  rollback_policy_id String? /// Circuit-breaker parameters linked to campaign monitoring
  status             CampaignStatus    @default(DRAFT)
  strategy           RolloutStrategy   @default(IMMEDIATE)
  rollout_percentage Float? /// For GRADUAL/CANARY: percentage of targets to update (0-100)
  min_version        String? /// Only target devices running >= this version
  max_version        String? /// Only target devices running <= this version
  scheduled_for      DateTime? /// When SCHEDULED: auto-activate at this UTC time
  start_time         DateTime?
  end_time           DateTime?
  success_rate       Float             @default(0)
  total_targets      Int               @default(0)
  success_targets    Int               @default(0)
  failed_targets     Int               @default(0)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  user_id            String
  firmwares          Firmwares         @relation(fields: [firmware_id], references: [id], onDelete: Cascade)
  device_groups      DeviceGroups?     @relation(fields: [group_id], references: [id], onDelete: SetNull)
  rollback_policy    RollbackPolicies? @relation(fields: [rollback_policy_id], references: [id], onDelete: SetNull)
  users              Users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ota_events         OtaEvents[]
  ota_targets        OtaTargets[]

  // campaign names scoped to each user
  @@unique([user_id, name])
  @@index([firmware_id])
  @@index([status])
  @@index([user_id])
  @@map("ota_campaigns")
}

/// This model contains row level security and requires additional setup for migrations.
model OtaEvents {
  id            String       @id @default(uuid())
  campaign_id   String
  event_type    OTAEventType
  message       String
  metadata      Json?
  created_at    DateTime     @default(now())
  ota_campaigns OtaCampaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
  @@index([event_type])
  @@map("ota_events")
}

/// This model contains row level security and requires additional setup for migrations.
model OtaTargets {
  id            String       @id @default(uuid())
  campaign_id   String
  device_id     String
  from_version  String?
  status        TargetStatus @default(PENDING)
  scheduled_for DateTime?
  started_at    DateTime?
  completed_at  DateTime?
  error_message String?
  retry_count   Int          @default(0)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  ota_campaigns OtaCampaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  devices       Devices      @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, device_id])
  @@index([campaign_id])
  @@index([device_id])
  @@index([status])
  @@map("ota_targets")
}

/// This model contains row level security and requires additional setup for migrations.
model RollbackPolicies {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  enabled            Boolean        @default(true)
  max_failure_rate   Float
  min_update_count   Int
  auto_rollback      Boolean        @default(true)
  notify_on_rollback Boolean        @default(true)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  created_by         String
  users              Users          @relation(fields: [created_by], references: [id], onDelete: Cascade)
  ota_campaigns      OtaCampaigns[]

  @@index([enabled])
  @@map("rollback_policies")
}

/// This model contains row level security and requires additional setup for migrations.
model TelemetryEvents {
  id         String        @id @default(uuid())
  device_id  String
  event_type TelemetryType
  payload    Json
  created_at DateTime      @default(now())
  devices    Devices       @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([device_id])
  @@index([event_type])
  @@map("telemetry_events")
}

/// This model contains row level security and requires additional setup for migrations.
model UpdateStates {
  id               String      @id @default(uuid())
  device_id        String
  from_version     String?
  to_version       String
  state            UpdatePhase @default(IDLE)
  progress         Int         @default(0)
  downloaded_bytes BigInt      @default(0)
  total_bytes      BigInt?
  error_message    String?
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  devices          Devices     @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([state])
  @@map("update_states")
}

/// This model contains row level security and requires additional setup for migrations.
model Users {
  id                  String               @id @default(uuid())
  email               String               @unique
  role                UserRole             @default(OPERATOR)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  user_name           String?
  avatar_url          String? // optional link to avatar image (provider or uploaded)
  // when the user signs up via OAuth we keep the original provider email here
  provider_email      String?              @unique
  // vendor/provider identifier (e.g. google, github)
  provider            String?
  password            String
  email_confirmed     Boolean              @default(false)
  email_confirmed_at  DateTime?
  alerts              Alerts[]
  audit_logs          AuditLogs[]
  devices             Devices[]
  device_groups       DeviceGroups[]
  filesystem_images   FilesystemImages[]
  firmwares           Firmwares[]
  ota_campaigns       OtaCampaigns[]
  rollback_policies   RollbackPolicies[]
  api_keys            ApiKeys[]
  blog_posts          BlogPosts[]
  documentation_pages DocumentationPages[]
  contact_replies     ContactReplies[]
  signed_url_logs     SignedUrlLogs[]

  @@map("users")
}

/// Per-device API keys for OTA authentication (fota_d_ prefix)
model DeviceApiKeys {
  id           String    @id @default(uuid())
  key_hash     String    @unique
  /// First 20 chars of the raw key — shown in dashboard as safe identifier
  key_prefix   String
  device_id    String
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  revoked      Boolean   @default(false)
  revoked_at   DateTime?
  devices      Devices   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([key_hash])
  @@map("device_api_keys")
}

/// Operator API Keys for device authentication
model ApiKeys {
  id           String    @id @default(uuid())
  name         String
  key_hash     String    @unique
  key_prefix   String
  user_id      String
  scopes       String[]  @default(["device:read", "device:write", "firmware:read"])
  expires_at   DateTime?
  last_used_at DateTime?
  revoked      Boolean   @default(false)
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  users        Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([key_hash])
  @@map("api_keys")
}

/// Blog posts managed by admin
model BlogPosts {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  content      String
  excerpt      String?
  cover_image  String?
  published    Boolean   @default(false)
  category     String?
  tags         String[]
  author_id    String
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  users        Users     @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([published])
  @@index([author_id])
  @@index([category])
  @@map("blog_posts")
}

/// Documentation pages managed by admin
model DocumentationPages {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String
  order_index Int      @default(0)
  published   Boolean  @default(false)
  author_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  users       Users    @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([category])
  @@index([published])
  @@index([author_id])
  @@map("documentation_pages")
}

/// Contact/support messages from public users
model ContactMessages {
  id         String           @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String
  status     ContactStatus    @default(NEW)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  replies    ContactReplies[]

  @@index([status])
  @@index([email])
  @@index([created_at])
  @@map("contact_messages")
}

/// Every signed URL (upload or download) issued for a firmware binary
model SignedUrlLogs {
  id          String    @id @default(uuid())
  firmware_id String
  user_id     String
  url_type    UrlType
  file_path   String
  expires_at  DateTime
  ip_address  String?
  user_agent  String?
  created_at  DateTime  @default(now())
  firmwares   Firmwares @relation(fields: [firmware_id], references: [id], onDelete: Cascade)
  users       Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([firmware_id])
  @@index([user_id])
  @@index([created_at])
  @@index([url_type])
  @@map("signed_url_logs")
}

/// Admin replies to contact messages
model ContactReplies {
  id               String          @id @default(uuid())
  message_id       String
  content          String
  author_id        String
  created_at       DateTime        @default(now())
  contact_messages ContactMessages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  users            Users           @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([author_id])
  @@map("contact_replies")
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  UPLOAD
  DOWNLOAD
  DEPLOY
  ROLLBACK
  URL_ISSUED
  VERIFY
}

enum UrlType {
  UPLOAD
  DOWNLOAD
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  UPDATING
  FAILED
  RETIRED
}

enum OTAEventType {
  CAMPAIGN_CREATED
  CAMPAIGN_STARTED
  CAMPAIGN_PAUSED
  CAMPAIGN_RESUMED
  CAMPAIGN_COMPLETED
  CAMPAIGN_CANCELLED
  CAMPAIGN_REACTIVATED
  TARGET_ADDED
  TARGET_UPDATED
  ERROR_OCCURRED
}

enum RolloutStrategy {
  IMMEDIATE
  GRADUAL
  CANARY
  SCHEDULED
}

enum TargetStatus {
  PENDING
  DOWNLOADING
  VERIFYING
  INSTALLING
  COMPLETED
  FAILED
  CANCELLED
}

enum TelemetryType {
  HEARTBEAT
  SYSTEM_HEALTH
  NETWORK_STATUS
  BATTERY_STATUS
  UPDATE_PROGRESS
  ERROR_REPORT
  CUSTOM
}

enum UpdatePhase {
  IDLE
  CHECKING
  DOWNLOADING
  DOWNLOADED
  VERIFYING
  INSTALLING
  REBOOTING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  ADMIN
  OPERATOR
  DEVICE
}

enum SignatureAlgorithm {
  ED25519
  RSA_SHA256
  ECDSA_P256
}

enum FirmwareStatus {
  DRAFT
  TESTING
  APPROVED
  DEPRECATED
  REVOKED
}

enum FileSystemType {
  LITTLEFS
  SPIFFS
  FATFS
  CUSTOM
}

enum FileSystemStatus {
  DRAFT
  APPROVED
  DEPRECATED
}
