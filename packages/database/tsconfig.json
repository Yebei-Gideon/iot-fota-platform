{
  "extends": "@fota/configs/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "index.ts",
    "generated/**/*",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}